# Copy this file to .env (same directory as docker-compose.yml) and fill in
# a real secret before running `docker compose up`. docker compose loads
# .env automatically. See docs/DOCKER.md.

# Required. Any long random string works. The same value must be set as
# INDRA_SERVER__SECRET_KEY on whatever desktop client connects to this
# backend - generate one with, e.g.:
#   openssl rand -hex 32
INDRA_SERVER_SECRET_KEY=

# Optional overrides (defaults shown):
# INDRA_HOST_PORT=3284
# INDRA_DATA_DIR=./indra-data
# INDRA_MODELS_DIR=./indra-models
# INDRA_WORKSPACE_DIR=./indra-workspace
